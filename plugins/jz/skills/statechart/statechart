#!/bin/sh
# Runs statechart.ts with Node 22.18 or later, which runs TypeScript directly.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
entry=$(dirname "$self")/statechart.ts
node=0
if command -v node >/dev/null; then
  node=$(node --version 2>/dev/null | sed -n '1s/[^0-9]*\([0-9]*\)\.\([0-9]*\)\.\([0-9]*\).*/\1 \2 \3/p' | {
    read -r major minor patch
    echo $((${major:-0} * 1000000 + ${minor:-0} * 1000 + ${patch:-0}))
  })
fi
# Type stripping is on by default from 22.18 in the 22 line and from 23.6 on.
if [ "$node" -ge 23006000 ] || { [ "$node" -ge 22018000 ] && [ "$node" -lt 23000000 ]; }; then
  exec node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON "$entry" "$@"
fi
cat >&2 <<'MSG'
statechart needs Node 22.18 or later (or 23.6 or later).
It installs nothing itself. Install it, for example with mise:
  mise use -g node@22
MSG
exit 127
